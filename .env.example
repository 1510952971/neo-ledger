# 外部自动记账通道密钥：请在本机 .env.local 中换成高强度随机字符串
SYNC_TOKEN=replace_with_a_long_random_secret

# 可选：邮箱验证码发信通道（Resend）。不配置也能用，验证码会打印到运行程序的终端。
# 1) 在 https://resend.com 注册并创建 API Key
# 2) 在 Domains 里添加并验证你的域名（加 DNS 记录），验证通过后才能用该域名发信
# 3) 只是本地试用的话，可以先用 Resend 提供的测试发件地址 onboarding@resend.dev，
#    但它只能发到你注册 Resend 时用的那个邮箱
RESEND_API_KEY=
MAIL_FROM=Neo Ledger <noreply@你的域名>
# 可选：极空间 NAS 上的 Ollama 地址与模型
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# 可选：微信开放平台“网站应用”登录。回调地址为：
# https://你的域名/api/auth/oauth/callback?provider=wechat
AUTH_PUBLIC_ORIGIN=https://你的域名
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 可选：支付宝开放平台网页应用 auth_user 登录。密钥使用 PKCS#8，换行可写成 \n。
# 回调地址为：https://你的域名/api/auth/oauth/callback?provider=alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
