# 外部自动记账通道密钥：请在本机 .env.local 中换成高强度随机字符串
SYNC_TOKEN=replace_with_a_long_random_secret

# 邮箱验证码发信通道（Resend）。邮箱验证和密码重置需要配置。
# 1) 在 https://resend.com 注册并创建 API Key
# 2) 在 Domains 里添加并验证你的域名（加 DNS 记录），验证通过后才能用该域名发信
# 3) 只是本地试用的话，可以先用 Resend 提供的测试发件地址 onboarding@resend.dev，
#    但它只能发到你注册 Resend 时用的那个邮箱
RESEND_API_KEY=
MAIL_FROM=Neo Ledger <noreply@你的域名>
# 可选：极空间 NAS 上的 Ollama 地址与模型
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# 安全开关：设为 true 时即使配置了 OLLAMA_URL 也禁止任何财务摘要外发
NEO_AI_EXTERNAL_DISABLED=false

# 可选：微信开放平台“网站应用”登录。回调地址为：
# https://你的域名/api/auth/oauth/callback?provider=wechat
AUTH_PUBLIC_ORIGIN=https://你的域名
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 可选：支付宝开放平台网页应用 auth_user 登录。密钥使用 PKCS#8，换行可写成 \n。
# 回调地址为：https://你的域名/api/auth/oauth/callback?provider=alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 可选：附近设备跨网段或复杂路由环境使用的 STUN 服务，多个地址用英文逗号分隔。
# 同一局域网直连通常可以留空。
P2P_STUN_URLS=

# 可选：固定显示给手机/平板使用的局域网地址。留空时本地开发会自动识别局域网 IPv4。
# 例如：http://192.168.1.95:3000
LAN_ORIGIN=

# 安全默认：普通自托管部署不要开启。仅当入口反向代理会验证
# oai-authenticated-user-* 请求头且不会让客户端直连应用时才设为 true。
NEO_TRUSTED_AUTH_HEADERS=false
# 可信代理签名密钥（至少 32 字节随机值）。开启上游身份头时必须同时配置。
NEO_TRUSTED_AUTH_SECRET=
# 代理签名受众；反向代理与 Neo Ledger 必须完全一致。
NEO_TRUSTED_AUTH_AUDIENCE=neo-ledger
# 允许发送可信身份证明的代理出口 IP，逗号分隔；留空时身份头会被拒绝。
NEO_TRUSTED_PROXY_IPS=

# 仅在确认整个站点通过 HTTPS 提供服务时开启 HSTS。
NEO_HSTS=false

# 部署安全模式：local（仅本机）、self_hosted（NAS/反向代理）或 cloud（严格启动门禁）。
DEPLOYMENT_MODE=local
# local 默认只监听 127.0.0.1；确需局域网直连时显式开启。Docker Compose 默认使用 self_hosted。
NEO_ENABLE_LAN=false
# 可选显式监听地址。通常无需设置；设置前确认防火墙和反向代理边界。
NEO_BIND_HOST=
# cloud 必填 Host 白名单，逗号分隔，不含协议、端口、路径或通配符。
NEO_ALLOWED_HOSTS=

# cloud 必填 WebDAV 备份目标域名白名单（逗号分隔，不含协议、路径或通配符）。
NEO_WEBDAV_ALLOWED_HOSTS=
