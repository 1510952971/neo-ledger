{
  "schemaVersion": 1,
  "product": "Neo Ledger",
  "repository": "1510952971/neo-ledger",
  "releaseTagPrefix": "native-v",
  "nativeClientVersion": "1.2.16",
  "minimumNativeClientVersion": "1.2.7",
  "apiVersion": "v1",
  "signedReleaseRequired": false,
  "signingPolicy": {
    "android": "required-for-stable",
    "windows": "when-configured; status-marker-required",
    "ios": "separate-apple-distribution",
    "macos": "when-configured; unsigned-test-allowed"
  },
  "currentRelease": {
    "tag": "native-v1.2.16",
    "windowsInstallerSigned": false,
    "windowsInstallerNote": "当前 Release 的 Windows EXE 未配置代码签名，仅用于测试；生产分发应配置证书。",
    "macosPreviewTag": "macos-preview-v1.2.16",
    "macosPackageSigned": false,
    "macosPackageNotarized": false,
    "macosPackageNote": "macOS 预览包未配置 Developer ID 签名/公证，仅用于测试；下一次 native-v* 稳定发布将包含 DMG/ZIP。"
  },
  "platforms": {
    "android": {
      "assetPatterns": [
        "neo-ledger-android-*.apk",
        "neo-ledger-android-*.aab"
      ],
      "distribution": "GitHub Releases / Play Console",
      "requiresSigningSecrets": true
    },
    "windows": {
      "assetPatterns": [
        "neo-ledger-windows-*-setup.exe",
        "neo-ledger-windows-*.zip"
      ],
      "distribution": "GitHub Releases (installer and portable ZIP; signature status in RELEASE_STATUS.json)",
      "requiresSigningSecrets": false,
      "signingSecretsRecommended": true,
      "signingPolicy": "when-configured",
      "currentInstallerSigned": false
    },
    "ios": {
      "assetPattern": null,
      "validationArtifactPattern": "neo-ledger-ios-unsigned-*.zip",
      "distribution": "TestFlight/App Store after Apple signing",
      "distributionWorkflow": ".github/workflows/ios-testflight.yml",
      "requiresAppleSigningSecrets": true,
      "installable": false
    },
    "macos": {
      "assetPatterns": [
        "neo-ledger-macos-*.dmg",
        "neo-ledger-macos-*.zip"
      ],
      "distribution": "GitHub Releases (DMG and portable app ZIP)",
      "requiresSigningSecrets": false,
      "signingSecretsRecommended": true,
      "signingPolicy": "when-configured; unsigned-test-allowed",
      "currentPackageSigned": false,
      "currentPackageNotarized": false,
      "installable": true
    },
    "web": {
      "assetPattern": "neo-ledger-web-*.tar.gz",
      "distribution": "Web/NAS deployment"
    }
  },
  "updatePolicy": {
    "clientChecks": "GitHub Releases native-v*",
    "sameMajorVersionRequired": true,
    "minimumApiVersion": "v1",
    "installMode": "user-confirmed-platform-installer"
  }
}
