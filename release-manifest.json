{
  "schemaVersion": 1,
  "product": "Neo Ledger",
  "repository": "1510952971/neo-ledger",
  "releaseTagPrefix": "native-v",
  "nativeClientVersion": "1.2.6",
  "minimumNativeClientVersion": "1.2.6",
  "apiVersion": "v1",
  "signedReleaseRequired": true,
  "platforms": {
    "android": {
      "assetPatterns": [
        "neo-ledger-android-*.apk",
        "neo-ledger-android-*.aab"
      ],
      "distribution": "GitHub Releases / Play Console",
      "requiresSigningSecrets": true
    },
    "windows": {
      "assetPatterns": [
        "neo-ledger-windows-*-setup.exe",
        "neo-ledger-windows-*.zip"
      ],
      "distribution": "GitHub Releases (signed installer and portable ZIP)",
      "requiresSigningSecrets": true,
      "signedInstaller": true
    },
    "ios": {
      "assetPattern": null,
      "validationArtifactPattern": "neo-ledger-ios-unsigned-*.zip",
      "distribution": "TestFlight/App Store after Apple signing",
      "distributionWorkflow": ".github/workflows/ios-testflight.yml",
      "requiresAppleSigningSecrets": true,
      "installable": false
    },
    "web": {
      "assetPattern": "neo-ledger-web-*.tar.gz",
      "distribution": "Web/NAS deployment"
    }
  },
  "updatePolicy": {
    "clientChecks": "GitHub Releases native-v*",
    "sameMajorVersionRequired": true,
    "minimumApiVersion": "v1",
    "installMode": "user-confirmed-platform-installer"
  }
}
